{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itops:2210:document-control:v1",
  "title": "GS-2210 Controlled Document Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "document_id",
    "document_type",
    "document_profile",
    "title",
    "subtitle",
    "summary",
    "version",
    "status",
    "visibility",
    "classification",
    "owner",
    "steward",
    "creator",
    "effective_date",
    "last_review_date",
    "review_date",
    "source_repository",
    "ghe_host",
    "source_branch",
    "content_path",
    "template_version",
    "contribution_paths",
    "use_restriction",
    "footer_text"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 3
    },
    "document_type": {
      "type": "string",
      "minLength": 2
    },
    "document_profile": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "subtitle": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[vV]?[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "status": {
      "type": "string"
    },
    "visibility": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "sensitivity": {
      "type": "string"
    },
    "service_or_system": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "steward": {
      "type": "string"
    },
    "approval_authority": {
      "type": "string"
    },
    "records_location": {
      "type": "string"
    },
    "review_cycle": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "related_documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "account",
        "work_ledger_id",
        "position_number",
        "created_at",
        "aliases"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "work_ledger_id": {
          "type": "string"
        },
        "position_number": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "effective_date": {
      "type": "string"
    },
    "last_review_date": {
      "type": "string"
    },
    "review_date": {
      "type": "string"
    },
    "source_repository": {
      "type": "string"
    },
    "repository_url": {
      "type": "string"
    },
    "ghe_host": {
      "type": "string"
    },
    "source_branch": {
      "type": "string"
    },
    "content_path": {
      "const": "content/index.md"
    },
    "edit_url": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "contribution_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "use_restriction": {
      "type": "string"
    },
    "footer_text": {
      "type": "string"
    }
  }
}
